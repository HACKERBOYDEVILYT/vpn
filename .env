# =========================
# NexaVPN API
# =========================

NODE_ENV=development

PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexavpn

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Used to encrypt VPN client private keys.
# Generate a strong random value in production.
VPN_KEY_ENCRYPTION_SECRET=replace-with-a-random-64-character-secret

# =========================
# CORS
# =========================

CORS_ORIGIN=http://localhost:5173

# =========================
# VPN
# =========================

VPN_DEFAULT_DNS=1.1.1.1,1.0.0.1

VPN_DEFAULT_MTU=1420
